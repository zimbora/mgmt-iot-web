<!DOCTYPE html>
<html lang="en">
<head>

  <style>

    .float-right {
      float: right;
    }


  </style>
  <%- include('../../partials/head.ejs') %>

</head>
<body>

  <%- include('../../partials/scripts.ejs') %>
  <%- include('../../partials/device/navbar.ejs') %>

  <%- include('../../partials/modal/confirmation.ejs') %>
  <%- include('../../partials/modal/error.ejs') %>
  <%- include('../../partials/modal/success.ejs') %>
  <%- include('../../partials/modal/addActuator.ejs') %>
  <%- include('../../partials/modal/loading.ejs') %>
  <%- include('../../partials/modal/timeout.ejs') %>
  <%- include('../../partials/modal/logsChart.ejs') %>
  <%- include('../../partials/modal/logsListActuator.ejs') %>
  <%- include('../../partials/modal/noResults.ejs') %>

  <link href="./assets/css/jquery.dataTables.min.css" rel="stylesheet"></script>
  <script src="./assets/js/jquery.dataTables.min.js"></script>
  <script src="./assets/js/fontawesome.js"></script>
  <script src="./assets/js/ace.js"></script>
  <script src="./assets/js/mqttws31.min.js" type="text/javascript"></script>
  <script type="module" src="./app.mjs"></script>

  <div class="container-fluid">
      <div class="row flex-nowrap">
          <%- include('../../partials/device/sidebar.ejs') %>
          <div class="col py-3">

                    <div class="row py-3">
          <div class="col-xs-12 col-sm-6 mb-4 mb-sm-0">
            <div class="content-header">
              <h5>MQTT Available
                <button id="mqtt_status" type="button" class="btn btn-secondary" disabled></button>
              </h5>
            </div>
          </div>
          <div class="col-xs-12 col-sm-6 mb-4 mb-sm-4">
            <div class="content-header">
              <h5>
                <%= device.name != null ? device.name : device.uid %>
                <button id="status" type="button" class="btn btn-secondary" disabled></button>
              </h5>
            </div>
          </div>
        </div>

        <div class="row py-3">

            <div class="content-header">
              <h3><%= model.name %></h3>
            </div>
            <div class="row">

                <div class="card py-3 overflow-auto">
                  <h5 class="card-title">
                    Available Actuators
                    <button id="openModelBtn" class="btn btn-primary mb-2 float-right" data-bs-toggle="modal" data-bs-target="#modalAddActuator">
                      + 
                    </button>
                  </h5>
                  <div class="card-body">
                    <table id="actuators" class="display">
                      <thead>
                        <tr>
                          <th>delete</th>
                          <th>active</th>
                          <th>ref</th>
                          <th>name</th>
                          <th>type</th>
                          <th>property</th>
                          <th>value</th>
                        </tr>
                      </thead>
                    </table>
                  </div>
                </div>
            </div>


          </div>
      </div>
  </div>

  <script>

    var ctx;
    var t;
    var table_list;
    var deviceId = api.getDeviceID();
    var device = <%- JSON.stringify(device) %>;
    var mqtt = <%- JSON.stringify(mqtt) %>;
    var actuators = <%- JSON.stringify(actuators) %>;
    const associated = <%- JSON.stringify(associated) %>;
    const fw = <%- JSON.stringify(fw) %>;
    const model = <%- JSON.stringify(model) %>;
    const modelFeat = <%- JSON.stringify(modelFeat) %>;

    let modelId = device.model_id;
    var timerInputChange = null;

    let project_name = <%- JSON.stringify(project_name) %>;
    let model_name = <%- JSON.stringify(model_name) %>;

    const uid = device.uid;
    var loading = $('#modalLoading');

    $(document).ready(function () {

      if(device?.status)
        changeDeviceStatus(device?.status);

      $('[data-toggle="tooltip"]').tooltip();
      const app = require('./app.mjs');
      t = $('#actuators').DataTable();
      table_list = $('#table_list').DataTable();
      ctx = echarts.init(document.getElementById('myChart'));

      let i = 0;
      Object.values(actuators).map((item) => {
        addRowDeviceActuator(item);

        if(i==Object.values(actuators).length-1){
          $('.form-check-input').on('change', function() {
            let id = $(this).attr('id');
            let active = "0";
            if ($(this).is(':checked'))
              active = "1";

            const valueInput = document.getElementById(`actuator-${id}`);
            const writeBtn = document.getElementById(`actuator-write-${id}`);
            if(valueInput) valueInput.disabled = (active === "0");
            if(writeBtn) writeBtn.disabled = (active === "0");

            api.device.updateActuator(deviceId,id,"active",active,(err,res)=>{
              if(err){
                $('#error').text("Your request cannot be executed");
                $('#suggestion').text(err);
                $('#modalError').modal('show');
              }
            });

          });

          $('.select_type').on('change', function() {
              let id = $(this).attr('id');
              let type = $(this).val();
              api.device.updateActuator(deviceId,id,"type",type,(err,res)=>{
                if(err){
                  $('#error').text("Your request cannot be executed");
                  $('#suggestion').text(err);
                  $('#modalError').modal('show');
                }
              });
          });
        }
        i++;

      });

      // connect the client
      if(mqtt != null){
        
        client = new Paho.MQTT.Client(Settings.mqtt.host, Settings.mqtt.port, mqtt.nick);

        // set callback handlers
        client.onConnectionLost = onConnectionLost;
        client.onMessageArrived = onMessageArrived;

        client.connect({
          userName:mqtt.type,
          password:mqtt.password,
          useSSL:Settings.mqtt.ssl,
          timeout:3,
          onSuccess:onConnect
        });
      }

    });

      // called when the client connects
    function onConnect() {
      // Once a connection has been made, make a subscription and send a message.
      let button = document.querySelector('#mqtt_status');
      button.classList.toggle("btn-secondary",false);
      button.classList.toggle("btn-success",true);

      // get uid of main device
      if(model_name === "sniffer"){ // add a different property to check when main device should be used
        client.subscribe(`${project_name}/${associated.uid}/app/${model_name}/${device.uid}/#`);
      }else{
        client.subscribe(project_name+"/"+uid+"/#");
      }
    }

    // called when the client loses its connection
    function onConnectionLost(responseObject) {
      console.log("connection lost");
      let button = document.querySelector('#mqtt_status');
      button.classList.toggle("btn-secondary",false);
      button.classList.toggle("btn-danger",true);
      if (responseObject.errorCode !== 0) {
        console.log("onConnectionLost:"+responseObject.errorMessage);
      }
    }

    // called when a message arrives
    function onMessageArrived(message) {

      let topic = message.destinationName;
      let payload = message.payloadString;

      if(model_name === "sniffer-gw"){
        if(topic.includes("/packets/"))
          return;
      }

      if(topic.includes("/status")){
        changeDeviceStatus(payload);
      }

    }

    function sendMessage(topic,payload){

      message = new Paho.MQTT.Message(payload);
      if(model_name === "sniffer"){
        message.destinationName = `${project_name}/${associated.uid}/app/${model_name}/${device.uid}/${topic}`;
      }else{
        message.destinationName = project_name+"/"+uid+"/"+topic;
      }
      
      loading.modal('show');
      setTimeout(()=>{
        client.send(message);
      },500)

      var timeoutId = setTimeout(()=>{
        loading.modal('hide'); // set confirmation
        $('#modalTimeout').modal('show');
      },15000);

      $(document).on("closeModalLoading", function() {
        loading.modal('hide'); // set confirmation
        clearTimeout(timeoutId);
      });
    }

    function addRowDeviceActuator(actuator){
      let state = "";
      if(actuator?.active)
        state = "checked"
      let disabled = actuator?.active ? '' : 'disabled';
      let set = actuator?.type == "set" ? "selected" : '';
      let sw = actuator?.type == "switch" ? "selected" : '';
      let number = actuator?.type == "number" ? "selected" : '';
      let text = actuator?.type == "text" ? "selected" : '';
      let json = actuator?.type == "json" ? "selected" : '';
      t.row.add([
        `<button id="delete-${actuator?.id}" onclick="deleteActuator('${actuator?.id}');" type="button" class="delete btn btn-danger btn-sm">
          <i class="fa-sharp fa-solid fa-trash"></i>
        </button>`,
        `<div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" role="switch" id=${actuator?.id} ${state}>
        </div>`,
        actuator?.ref,
        `<input type="text" class="form-control" id=${actuator?.id} value="${actuator?.name}" oninput="handleNameChange(${actuator?.id},this.value)">`,
        `<select class="form-control select_type" id=${actuator?.id} name="dataTypes" value=${actuator?.type}>
          <option value=""></option>
          <option ${set} value="set">set</option>
          <option ${sw} value="switch">switch</option>
          <option ${number} value="number">number</option>
          <option ${text} value="text">text</option>
          <option ${json} value="json">json</option>
        </select>`,
        actuator?.property,
        `<div class="d-flex align-items-center gap-2">
          <button class="btn btn-light btn-sm" type="button"
            onclick="Display.showActuatorsLogs(${actuator?.id}, '${actuator?.type}')"
            title="View logs">
            <i class="bi bi-list"></i>
          </button>
          <input id="actuator-${String(actuator?.id)}" type="text" class="form-control form-control-sm" ${disabled}
            value="${String(actuator?.value != null ? actuator?.value : '')}">
          <button id="actuator-write-${String(actuator?.id)}" class="btn btn-primary btn-sm" type="button" ${disabled}
            onclick="writeActuator('${actuator?.id}','${actuator?.ref}')"
            title="Write value">
            <i class="bi bi-send"></i>
          </button>
        </div>`,
      ]).draw(true);

    }

    function handleNameChange(id,value){
      clearTimeout(timerInputChange);
      timerInputChange = setTimeout(function() {
        api.device.updateActuator(deviceId,id,"name",value,(err,res)=>{
          if(err){
            $('#error').text("Your request cannot be executed");
            $('#suggestion').text(err);
            $('#modalError').modal('show');
          }
        });

      }, 1000); // 500ms delay
    }

    function addActuator(){
      let ref = $("#_modalActuatorRef_").val();
      let name = $("#_modalActuatorName_").val();
      let type = $("#actuatorType").val();
      const property = $("#_modalActuatorProperty_").val();

      // Validation (optional)
      if (!ref || !name || !type || !deviceId) {
        $('#error').text("Invalid fields");
        $('#suggestion').text("Check your fields and retry again");
        $('#modalError').modal('show');
        return;
      }

      if (type.toLowerCase() === "json" && !property) {
        $('#error').text("Invalid fields");
        $('#suggestion').text("You must define a property");
        $('#modalError').modal('show');
        return;
      }

      api.device.addActuator(deviceId,ref,name,type,property,(err,res)=>{
        if(err){
          $('#error').text("Error adding actuator");
          if(err.hasOwnProperty("sqlMessage"))
            $('#suggestion').text(err.sqlMessage);
          else
            $('#suggestion').text(err);
          $('#modalError').modal('show');
        }else{
          // Show success message
          $("#successHeader").text("Actuator successfully added");
          $('#successMsg').text(`Actuator ${name} has been created and associated to device id: ${deviceId}`);
          $('#modalSuccess').modal('show');
          
          // Reload page to show the new model
          setTimeout(() => {
            location.reload();
          }, 2000);
        }
      });
    }

    function showAddActuatorModal(){
      $('#modalAddActuator').modal('show');
    }

    var actuatorIdToDelete = null;

    function deleteActuator(actuatorId){
      actuatorIdToDelete = actuatorId;
      $('#modal_message').text(`You are about to delete actuator with ID: ${actuatorId}`);
      $('#modalConfirmation').modal('show');
    }

    $("#modalProceed").click(()=>{
      if(actuatorIdToDelete){
        const idToDelete = actuatorIdToDelete;
        actuatorIdToDelete = null;
        api.device.deleteActuator(deviceId, idToDelete, (err,res)=>{
          if(err){
            $('#error').text("Your request cannot be executed");
            $('#suggestion').text(err);
            $('#modalError').modal('show');
          }else{
            location.reload();
          }
        });
      }
    });

    function writeActuator(id,ref){
      const el = document.getElementById(`actuator-${id}`);
      const value = el ? el.value : null;

      api.device.updateActuator(deviceId,id,"value",value,(err,res)=>{
        if(err){
          $('#error').text("Your request cannot be executed");
          $('#suggestion').text(err.hasOwnProperty && err.hasOwnProperty("sqlMessage") ? err.sqlMessage : err);
          $('#modalError').modal('show');
        }else{
          sendMessage(ref+"/set",String(value));
        }
      });
    }

    function changeDeviceStatus(payload){
      let button = document.querySelector('#status');
      button.classList.remove("btn-secondary");
      // Update device status tracking
      if (payload === "online") {
        deviceStatus = "online";
        button.classList.remove("btn-danger", "btn-warning");
        button.classList.add("btn-success");
      } else if (payload === "idle") {
        deviceStatus = "idle";
        button.classList.remove("btn-danger", "btn-success");
        button.classList.add("btn-warning");
      } else {
        deviceStatus = "offline";
        button.classList.remove("btn-success", "btn-warning");
        button.classList.add("btn-danger");
      }
    }
    
  </script>
</body>
</html>
