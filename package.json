{
  "name": "mgmt-iot-web",
  "version": "1.1.2",
  "description": "web platform to configure and interact with iot devices using mqtt",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand",
    "test:routes": "jest --runInBand test/routes",
    "test:controllers": "jest --runInBand test/controllers",
    "test:models": "jest --runInBand test/models",
    "test:coverage": "jest --runInBand --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "transform": {}
  },
  "keywords": [
    "iot",
    "mqtt",
    "device",
    "esp32"
  ],
  "author": "João Silva",
  "license": "ISC",
  "dependencies": {
    "async": "^3.2.4",
    "body-parser": "^1.20.1",
    "console-log-level": "^1.4.1",
    "crc": "^4.3.2",
    "crypto-js": "^4.1.1",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.0",
    "express-jwt": "^8.2.1",
    "express-session": "^1.17.3",
    "express-useragent": "^1.0.15",
    "express-validation": "^4.1.0",
    "google-auth-library": "^10.9.1",
    "http-status-codes": "^2.2.0",
    "joi": "^17.7.0",
    "marked": "^18.0.7",
    "moment": "^2.29.4",
    "mqtt": "^5.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.2.0",
    "node-docker-api": "^1.1.22",
    "path": "^0.12.7",
    "serve-index": "^1.9.1"
